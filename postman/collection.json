                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Bentuk respons { data, page, limit, total }\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.all.keys(\"data\", \"page\", \"limit\", \"total\");",
                  "  pm.expect(b.data).to.be.an('array');",
                  "  pm.expect(b.page).to.eql(1);",
                  "  pm.expect(b.limit).to.eql(10);",
                  "  pm.expect(b.total).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Filter berdasarkan kantinId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu?kantinId={{kantinId}}",
              "host": [

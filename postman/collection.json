{
  "info": {
    "name": "SI0027 PAW II - Latihan UTS - Menu Kantin",
    "description": "Koleksi pengujian otomatis Latihan UTS PAW II (RESTful API CRUD Menu Kantin Kampus).\n\nJalankan folder berurutan dari atas ke bawah (Collection Runner atau Newman) dengan environment 'Latihan UTS - Local'. Request saling berantai lewat variabel environment (kantinId, menuId, ...). Data unik dibuat otomatis pada request 1.1 sehingga collection dapat dijalankan berulang kali.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Kantin",
      "item": [
        {
          "name": "1.1 Buat kantin - sukses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kantin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kantin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{kantinNama}}\",\n  \"lokasi\": \"Gedung A Lantai 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data unik per run supaya collection bisa dijalankan berulang kali",
                  "const ts = Date.now();",
                  "pm.environment.set(\"kantinNama\", \"Kantin Latihan \" + ts);",
                  "const base = String(ts).slice(-6).padStart(6, '0');",
                  "pm.environment.set(\"kode1\", \"MN-\" + base);",
                  "pm.environment.set(\"kode2\", \"MN-\" + String((Number(base) + 1) % 1000000).padStart(6, \"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Kantin tersimpan\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"_id\");",
                  "  pm.expect(body.nama).to.eql(pm.environment.get(\"kantinNama\"));",
                  "  pm.environment.set(\"kantinId\", body._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Buat kantin - nama duplikat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kantin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kantin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{kantinNama}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body memuat properti message\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"message\");",
                  "  pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Daftar kantin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/kantin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "kantin"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Berupa array dan memuat kantin yang baru dibuat\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  const ids = body.map(function (k) { return k._id; });",
                  "  pm.expect(ids).to.include(pm.environment.get(\"kantinId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

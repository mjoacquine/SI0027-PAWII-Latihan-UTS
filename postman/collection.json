                  "pm.test(\"Hanya menu pada kantin tsb (total = 2)\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.total).to.eql(2);",
                  "  pm.expect(b.data).to.have.lengthOf(2);",
                  "  b.data.forEach(function (x) {",
                  "    pm.expect(x.kantinId._id).to.eql(pm.environment.get(\"kantinId\"));",
                  "  });",
                  "});"
                ]
              }
            }

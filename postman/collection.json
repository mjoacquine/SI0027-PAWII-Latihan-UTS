            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Nasi Goreng Spesial\",\n  \"kode\": \"{{kode1}}\",\n  \"bahan\": [\n    \"Beras\",\n    \"Telur\",\n    \"Bawang\"\n  ],\n  \"gizi\": {\n    \"kalori\": 450,\n    \"protein\": 15\n  },\n  \"harga\": 12000,\n  \"kantinId\": \"{{kantinId}}\",\n  \"tersedia\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Menu tersimpan lengkap (embedded & referencing)\", function () {",
                  "  const m = pm.response.json();",
                  "  pm.expect(m).to.have.property(\"_id\");",
                  "  pm.expect(m.nama).to.eql(\"Nasi Goreng Spesial\");",
                  "  pm.expect(m.kode).to.eql(pm.environment.get(\"kode1\"));",
                  "  pm.expect(m.bahan).to.eql([\"Beras\", \"Telur\", \"Bawang\"]);",
                  "  pm.expect(m.gizi).to.include({ kalori: 450, protein: 15 });",
                  "  pm.expect(m.kantinId).to.eql(pm.environment.get(\"kantinId\"));",
                  "  pm.expect(m.harga).to.eql(12000);",
                  "  pm.expect(m.tersedia).to.eql(true);",
                  "  pm.environment.set(\"menuId\", m._id);",
                  "});"
                ]
              }
            }
          ]
        },
